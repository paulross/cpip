# =============================================================================
# Project: CPIPDemo
# Configurations: Debug
# =============================================================================

#############################################
# Minimal version of Ninja required by this file

ninja_required_version = 1.5


#############################################
# Set configuration variable for custom commands.

CONFIGURATION = Debug
# =============================================================================
# Include auxiliary files.


#############################################
# Include rules file.

include CMakeFiles/rules.ninja

# =============================================================================

#############################################
# Logical path to working directory; prefix for absolute paths.

cmake_ninja_workdir = /Users/engun/Documents/workspace/cpip/CMake/CPIPDemo/cmake-build-debug/
# =============================================================================
# Object build statements for EXECUTABLE target CPIPDemo


#############################################
# Order-only phony target for CPIPDemo

build cmake_object_order_depends_target_CPIPDemo: phony || CMakeFiles/CPIPDemo.dir

build CMakeFiles/CPIPDemo.dir/main.c.o: C_COMPILER__CPIPDemo_Debug /Users/engun/Documents/workspace/cpip/CMake/CPIPDemo/main.c || cmake_object_order_depends_target_CPIPDemo
  DEP_FILE = CMakeFiles/CPIPDemo.dir/main.c.o.d
  FLAGS = -g -isysroot /Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX14.0.sdk -mmacosx-version-min=13.5 -fcolor-diagnostics -std=gnu99
  INCLUDES = -I/Users/engun/Documents/workspace/cpip/CMake/CPIPDemo/sys -I/Users/engun/Documents/workspace/cpip/CMake/CPIPDemo/usr
  OBJECT_DIR = CMakeFiles/CPIPDemo.dir
  OBJECT_FILE_DIR = CMakeFiles/CPIPDemo.dir


# =============================================================================
# Link build statements for EXECUTABLE target CPIPDemo


#############################################
# Link the executable CPIPDemo

build CPIPDemo: C_EXECUTABLE_LINKER__CPIPDemo_Debug CMakeFiles/CPIPDemo.dir/main.c.o
  FLAGS = -g -isysroot /Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX14.0.sdk -mmacosx-version-min=13.5
  OBJECT_DIR = CMakeFiles/CPIPDemo.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = CPIPDemo
  TARGET_PDB = CPIPDemo.dbg


#############################################
# Utility command for edit_cache

build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /Users/engun/Documents/workspace/cpip/CMake/CPIPDemo/cmake-build-debug && "/Users/engun/Library/Application Support/JetBrains/Toolbox/apps/CLion/ch-1/223.8836.42/CLion.app/Contents/bin/cmake/mac/bin/cmake" -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /Users/engun/Documents/workspace/cpip/CMake/CPIPDemo/cmake-build-debug && "/Users/engun/Library/Application Support/JetBrains/Toolbox/apps/CLion/ch-1/223.8836.42/CLion.app/Contents/bin/cmake/mac/bin/cmake" --regenerate-during-build -S/Users/engun/Documents/workspace/cpip/CMake/CPIPDemo -B/Users/engun/Documents/workspace/cpip/CMake/CPIPDemo/cmake-build-debug
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util

